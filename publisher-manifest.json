ry-soft)}\n  .plan .tier{font-size:.78rem;letter-spacing:.26em;margin:0 0 6px;color:var(--wine);font-weight:700}\n  .plan.flagship .tier{color:#e9c39a}\n  .plan h3{margin:0 0 4px;font-size:1.32rem;letter-spacing:.03em}\n  .plan.flagship h3{color:#fff}\n  .plan .price{font-size:1.9rem;font-weight:800;margin:8px 0 2px;color:var(--wine-deep);letter-spacing:-.01em}\n  .plan.flagship .price{color:#fff}\n  .plan .annual{font-size:.83rem;margin:0 0 18px;color:var(--ink-soft);border-bottom:1px dashed rgba(43,27,24,.35);padding-bottom:14px}\n  .plan.flagship .annual{color:rgba(246,241,230,.85);border-bottom-color:rgba(246,241,230,.4)}\n  .plan ul{list-style:none;margin:0;padding:0;font-size:.92rem;flex:1}\n  .plan li{position:relative;padding-left:18px;margin-bottom:11px;line-height:1.6}\n  .plan li::before{content:\"·\";position:absolute;left:2px;top:-2px;font-size:1.5rem;color:var(--wine);font-weight:800}\n  .plan.flagship li::before{color:#e9c39a}\n  .plan .tag{display:inline-block;margin-top:16px;font-size:.74rem;letter-spacing:.2em;border:1px solid currentColor;padding:3px 9px;align-self:flex-start}\n\n  .note-line{margin:26px 0 0;font-size:.88rem;color:var(--ink-soft);border-left:4px solid var(--wine);padding:6px 0 6px 14px;max-width:70ch}\n\n  .clients{display:grid;grid-template-columns:1fr 1fr;gap:0;border:2px solid var(--line)}\n  .client{padding:24px 24px 26px;border-right:2px solid var(--line);border-bottom:2px solid var(--line)}\n  .client:nth-child(2n){border-right:none}\n  .client:nth-last-child(-n+2){border-bottom:none}\n  .client h3{margin:0 0 6px;font-size:1.05rem;color:var(--wine-deep)}\n  .client .meta{font-size:.8rem;letter-spacing:.14em;color:var(--wine);margin:0 0 10px}\n  .client p{margin:0;font-size:.92rem;color:var(--ink-soft)}\n\n  .steps{list-style:none;margin:0;padding:0;counter-reset:step}\n  .steps li{border:2px solid var(--line);padding:22px 24px 22px 84px;margin-bottom:14px;position:relative;background:var(--ivory)}\n  .steps li::before{counter-increment:step;content:counter(step,decimal-leading-zero);position:absolute;left:22px;top:20px;font-size:1.75rem;font-weight:800;color:var(--wine);line-height:1}\n  .steps h3{margin:0 0 6px;font-size:1.02rem}\n  .steps p{margin:0;font-size:.92rem;color:var(--ink-soft)}\n\n  .faq-group{margin-bottom:34px}\n  .faq-group:last-child{margin-bottom:0}\n  .faq-group > h3{font-size:.86rem;letter-spacing:.24em;color:var(--wine);margin:0 0 14px;padding-bottom:8px;border-bottom:2px solid var(--line)}\n  .qa{border:2px solid var(--line);padding:0;margin-bottom:12px;background:var(--ivory)}\n  .qa:last-child{margin-bottom:0}\n  .qa .q{margin:0;padding:16px 20px;font-size:1rem;font-weight:700;color:var(--wine-deep);border-bottom:2px solid var(--line);background:var(--ivory-soft)}\n  .qa .a{margin:0;padding:16px 20px;font-size:.93rem;color:var(--ink-soft)}\n\n  .closing{background:var(--wine);color:var(--ivory);border-bottom:none;padding:64px 5vw 72px}\n  .closing h2{font-size:clamp(1.8rem,5vw,3.4rem);margin:0 0 18px;color:#fff;line-height:1.2;letter-spacing:-.01em}\n  .closing p{max-width:52ch;margin:0 0 14px;color:rgba(246,241,230,.9)}\n  .closing .links{margin-top:24px;display:flex;gap:14px;flex-wrap:wrap}\n  .closing .links a{color:var(--ivory);border:1px solid rgba(246,241,230,.6);padding:8px 18px;font-size:.9rem;letter-spacing:.1em}\n  .closing .links a:hover{background:rgba(246,241,230,.12)}\n\n  footer{background:var(--wine-deep);color:rgba(246,241,230,.72);padding:26px 5vw;font-size:.82rem;letter-spacing:.04em;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}\n\n  @media (max-width:900px){\n    .hero-grid{grid-template-columns:1fr}\n    .intro-grid{grid-template-columns:1fr}\n    .intro-grid > div{border-right:none;border-bottom:2px solid var(--line)}\n    .intro-grid > div:last-child{border-bottom:none}\n    .plans{grid-template-columns:1fr;align-items:stretch}\n    .plan{border-right:none;border-bottom:2px solid var(--line);padding-bottom:26px}\n    .plan.flagship{padding-bottom:26px}\n    .plan.team{padding-bottom:26px}\n    .plan:last-child{border-bottom:none}\n    .clients{grid-template-columns:1fr}\n    .client{border-right:none}\n    .client:nth-child(2n){border-right:none}\n    .client:nth-last-child(-n+2){border-bottom:2px solid var(--line)}\n    .client:last-child{border-bottom:none}\n  }\n  @media (max-width:760px){\n    .layout{display:block}\n    .sidenav{position:static;width:auto;height:auto;flex-direction:row;flex-wrap:wrap;align-items:center;gap:12px 20px;padding:16px 20px}\n    .sidenav .mark{margin:0;padding:0;border:none;font-size:.95rem;letter-spacing:.18em}\n    .sidenav ul{display:flex;flex-wrap:wrap;gap:6px 16px}\n    .sidenav li{margin:0}\n    .sidenav li a{padding:2px 0 2px 8px;font-size:.84rem}\n    .sidenav .foot{display:none}\n    .hero{padding:34px 5vw 44px}\n    .hero h1{line-height:.86}\n  }\n</style><div class=\"layout\">\n  <nav class=\"sidenav\" aria-label=\"页面目录\">\n    <div>\n      <div class=\"mark\">ULTRALINK</div>\n      <ul>\n        <li><a href=\"#hero\">开篇</a></li>\n        <li><a href=\"#what\">这是什么</a></li>\n        <li><a href=\"#plans\">订阅方案</a></li>\n        <li><a href=\"#clients\">客户端</a></li>\n        <li><a href=\"#howto\">使用步骤</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n      </ul>\n    </div>\n    <div class=\"foot\">页面内容以说明为主<br>实时信息以官方渠道为准</div>\n  </nav>\n\n  <main>\n    <header class=\"hero\" id=\"hero\">\n      <p class=\"kicker\">订阅之前，先把话说完</p>\n      <h1>UltraLink</h1>\n      <div class=\"rule\"></div>\n      <div class=\"hero-grid\">\n        <p class=\"hero-lead\">\n          UltraLink 不是那种一进门就催你下单的页面。我们更愿意把\n          <strong>能做什么、按什么节奏收费、客户端怎么装</strong>\n          先摊开讲清楚，你看完觉得合适，再决定要不要继续。\n        </p>\n        <div class=\"hero-note\">\n          <h2>先看三句话</h2>\n          <p>一，方案按流量与同时在线设备数分档，价格写在明面上。</p>\n          <p>二，年付比月付省一笔，但不自动续，也不催你一次付很多年。</p>\n          <p class=\"sign\">三，遇到问题先看常见问题，那里写了我们最常被问的答案。</p>\n        </div>\n      </div>\n    </header>\n\n    <section id=\"what\">\n      <div class=\"sec-head\">\n        <span class=\"no\">01</span>\n        <h2>用朋友的方式，说清楚这件事</h2>\n        <p class=\"desc\">不喊口号，只把关系讲明白：你付钱，我们提供服务，两边都不绕弯子。</p>\n      </div>\n      <div class=\"intro-grid\">\n        <div>\n          <h3>方案不玩文字游戏</h3>\n          <p>月付、年付两个价格都摆出来，流量额度和在线设备数写成具体数字，方便你横着比、竖着算。</p>\n        </div>\n        <div>\n          <h3>客户端不藏着掖着</h3>\n          <p>桌面端和移动端分别是什么形态、适合谁用、注意什么，都单独列了一节，装之前先看一眼。</p>\n        </div>\n        <div>\n          <h3>问题有人接</h3>\n          <p>常见问题按主题分组，先看有没有现成答案；没找到，再走工单，别在评论区干等。</p>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"plans\">\n      <div class=\"sec-head\">\n        <span class=\"no\">02</span>\n        <h2>三档方案，像台阶一样往上走</h2>\n        <p class=\"desc\">从左边的基础版起步，每上一级，流量、设备数和附加支持都跟着加一档。</p>\n      </div>\n\n      <div class=\"plans\">\n        <article class=\"plan basic\">\n          <p class=\"tier\">第一级</p>\n          <h3>基础版</h3>\n          <p class=\"price\">¥15<span>/月</span></p>\n          <p class=\"annual\">按年付仅需 ¥150/年</p>\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <span class=\"tag\">适合先试试水</span>\n        </article>\n\n        <article class=\"plan flagship\">\n          <p class=\"tier\">第二级 · 推荐</p>\n          <h3>旗舰版</h3>\n          <p class=\"price\">¥35<span>/月</span></p>\n          <p class=\"annual\">按年付仅需 ¥350/年</p>\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <span class=\"tag\">多数人停在这一级</span>\n        </article>\n\n        <article class=\"plan team\">\n          <p class=\"tier\">第三级</p>\n          <h3>团队版</h3>\n          <p class=\"price\">¥85<span>/月</span></p>\n          <p class=\"annual\">按年付仅需 ¥850/年</p>\n          <ul>\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理对接</li>\n          </ul>\n          <span class=\"tag\">给一群人用</span>\n        </article>\n      </div>\n\n      <p class=\"note-line\">\n        以上价格与权益均按当前展示口径列出，实际扣费与结算方式以付款页面为准；如需发票或团队采购流程，请通过工单联系我们确认。\n      </p>\n    </section>\n\n    <section id=\"clients\">\n      <div class=\"sec-head\">\n        <span class=\"no\">03</span>\n        <h2>客户端：四种形态，对号入座</h2>\n        <p class=\"desc\">不用一个客户端打天下，按你的设备和使用场景挑，安装说明写在对应条目里。</p>\n      </div>\n\n      <div class=\"clients\">\n        <article class=\"client\">\n          <h3>桌面客户端</h3>\n          <p class=\"meta\">Windows / macOS</p>\n          <p>安装包从官方渠道获取，安装后使用账户凭据登录即可。适合长时间在电脑前工作、需要多设备切换的人。</p>\n        </article>\n        <article class=\"client\">\n          <h3>移动客户端</h3>\n          <p class=\"meta\">iOS / Android</p>\n          <p>在手机应用商店按名称检索获取，界面以列表方式呈现在线状态，适合通勤、出差时临时使用。</p>\n        </article>\n        <article class=\"client\">\n          <h3>路由器端</h3>\n          <p class=\"meta\">家用路由</p>\n          <p>适合希望整屋设备统一管理的用户。配置过程对路由器固件有要求，动手前建议先看设备支持说明。</p>\n        </article>\n        <article class=\"client\">\n          <h3>浏览器扩展</h3>\n          <p class=\"meta\">桌面浏览器</p>\n          <p>轻量形态，只处理浏览器内的访问，不接管系统其他流量。适合临时查资料，不适合作为唯一方案。</p>\n        </article>\n      </div>\n      <p class=\"note-line\">\n        本文不提供下载地址；客户端安装包与最新版本号请以官方渠道发布的信息为准，我们不在第三方页面分发安装文件。\n      </p>\n    </section>\n\n    <section id=\"howto\">\n      <div class=\"sec-head\">\n        <span class=\"no\">04</span>\n        <h2>从零开始，四步就够</h2>\n        <p class=\"desc\">第一次使用的朋友，照着往下走，基本不会卡住。</p>\n      </div>\n      <ol class=\"steps\">\n        <li>\n          <h3>挑一档方案</h3>\n          <p>先估算自己每月的用量和常在线设备数量，对着上面的三档选，不必一上来就上最高档。</p>\n        </li>\n        <li>\n          <h3>完成订阅</h3>\n          <p>在付款页面核对方案名称、周期和金额，确认无误后提交。年付与月付是两条路径，选之前想清楚。</p>\n        </li>\n        <li>\n          <h3>安装对应客户端</h3>\n          <p>按你的设备形态，从官方渠道获取安装包，安装后用账户凭据登录，不要在陌生页面输入密码。</p>\n        </li>\n        <li>\n          <h3>连上之后再微调</h3>\n          <p>登录后先试着访问几个常用站点，再根据实际体验调整节点选择策略；遇到异常先看常见问题。</p>\n        </li>\n      </ol>\n    </section>\n\n    <section id=\"faq\">\n      <div class=\"sec-head\">\n        <span class=\"no\">05</span>\n        <h2>常见问题，按主题归好类</h2>\n        <p class=\"desc\">先看这三组，九成疑问能在这里找到答案。</p>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于订阅与付费</h3>\n        <article class=\"qa\">\n          <h2 class=\"q\">月付和年付差在哪里？</h2>\n          <p class=\"a\">差别只在结算周期和总价。年付把 12 个月一次结清，折算下来更省，但需要你一次拿出全年费用；月付灵活，按月结清，总支出更高一些。没有其他隐藏差别。</p>\n        </article>\n        <article class=\"qa\">\n          <h2 class=\"q\">中途想换档，可以吗？</h2>\n          <p class=\"a\">可以联系我们处理，具体折算方式取决于你当前已用时长和剩余周期，以工单确认结果为准。我们不建议在周期刚开始时频繁换档，算起来容易糊涂。</p>\n        </article>\n        <article class=\"qa\">\n          <h2 class=\"q\">团队版是不是要提供公司信息？</h2>\n          <p class=\"a\">团队版面向多人协作场景，需要你说明大致的使用人数和用途，以便确认路由与账号如何分配。是否涉及企业资质，请与客户经理沟通确认。</p>\n        </article>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于客户端与设备</h3>\n        <article class=\"qa\">\n          <h2 class=\"q\">同时在线设备数是怎么算的？</h2>\n          <p class=\"a\">按同一时间保持连接状态的设备数量计算。基础版 3 台、旗舰版 5 台、团队版 20 台。手机和电脑各算一台，路由器上统一管理的设备按一台计。</p>\n        </article>\n        <article class=\"qa\">\n          <h2 class=\"q\">浏览器扩展能替代桌面客户端吗？</h2>\n          <p class=\"a\">不能完全替代。扩展只作用于浏览器内的访问，其他应用的流量它管不到。如果你只需要在浏览器里查资料，扩展够用；如果是日常工作流，建议用桌面客户端。</p>\n        </article>\n        <article class=\"qa\">\n          <h2 class=\"q\">安装包从哪里拿？</h2>\n          <p class=\"a\">只从官方渠道获取。我们不会在社交软件群里散落安装文件，也不会让你在非官方页面输入账户密码。拿不准的链接，先来问一句再点。</p>\n        </article>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于使用过程</h3>\n        <article class=\"qa\">\n          <h2 class=\"q\">连上之后感觉慢，先从哪里查？</h2>\n          <p class=\"a\">先确认当前档位的流量额度是否用完，再换一个节点试；如果换节点有改善，多半是单条线路的临时状况。仍然不行，把时间点、设备类型和现象写进工单，我们好定位。</p>\n        </article>\n        <article class=\"qa\">\n          <h2 class=\"q\">遇到问题，工单多久回？</h2>\n          <p class=\"a\">旗舰版与团队版走优先工单通道，基础版按常规顺序处理。实际响应时间受时段影响，我们会在工单里如实告知排队情况，不承诺做不到的时限。</p>\n        </article>\n        <article class=\"qa\">\n          <h2 class=\"q\">有没有使用日志留存？</h2>\n          <p class=\"a\">我们只保留维持服务运行与结算所需的最少信息，不记录你访问的具体内容。具体口径以官方说明为准，若你在意这一条，请先通过工单向我们索取完整说明。</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"closing\">\n      <h2>看到这里，说明你愿意先弄明白再决定</h2>\n      <p>这是我们对的方式。UltraLink 会把方案、价格和客户端细节一直摆在明面上，不做临时加价，也不靠催单推进。</p>\n      <p>如果还有没写到的问题，直接来问，我们按朋友聊天的节奏回你。</p>\n      <div class=\"links\">\n        <a href=\"#plans\">再看一眼方案</a>\n        <a href=\"#faq\">翻回常见问题</a>\n      </div>\n    </section>\n\n    <footer>\n      <span>UltraLink · 页面内容以说明与展示为主</span>\n      <span>价格与权益以付款页面为准</span>\n    </footer>\n  </main>\n</div>",
          "hash": "9ec73a25e46ec348c871fb1314e436527406d3848d73f430c2aa60f015bb5b70",
